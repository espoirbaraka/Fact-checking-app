# URL publique (sans slash final)
PUBLIC_URL=http://82.29.170.149:8087

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT
POSTGRES_DB=fact_checking

# Backend JWT — générez des secrets longs et uniques
JWT_SECRET=CHANGEZ_MOI_JWT_SECRET_LONG
JWT_REFRESH_SECRET=CHANGEZ_MOI_REFRESH_SECRET_LONG

# Premier déploiement : true pour créer les tables, puis repassez à false
TYPEORM_SYNCHRONIZE=true

# Modèle Ollama (7b = plus précis, 3b = moins de RAM)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

# Recherche web (sources → Oui, aucune source → Non)
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_MAX_RESULTS=3
TRUSTED_SOURCE_DOMAINS=radiookapi.net,rfi.fr,france24.com,tv5monde.com,rtnc.cd,actualite.cd,mediacongo.net,reuters.com,apnews.com,bbc.com,afp.com
