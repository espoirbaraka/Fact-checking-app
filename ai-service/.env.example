APP_NAME=ai-fact-checking-service
APP_ENV=development
APP_PORT=8000

DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fact_checking_ai

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=qwen2.5:3b

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

OPENFACTCHECK_ENABLED=false
WEB_RESEARCH_ENABLED=true
WEB_RESEARCH_MAX_RESULTS=6
TRUSTED_SOURCE_DOMAINS=radiookapi.net,rfi.fr,france24.com,tv5monde.com,rtnc.cd,actualite.cd,mediacongo.net,reuters.com,apnews.com,bbc.com,afp.com

# Optional: API key for service-to-service auth (NestJS backend)
API_KEY=

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000
